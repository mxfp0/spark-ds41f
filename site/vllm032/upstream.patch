From 3cada3d84b06468473d68a3024d2fa7003b58e80 Mon Sep 17 00:00:00 2001
From: Herlon Aguiar <3419441+mxfp0@users.noreply.github.com>
Date: Tue, 20 Oct 2026 00:53:43 +0200
Subject: [PATCH 3/7] Allow disk Engram with guarded breakable graphs


---
 vllm/config/engram.py |  2 +-
 vllm/config/vllm.py   | 17 ++++++++++++++---
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/vllm/config/engram.py b/vllm/config/engram.py
index ab19d01..bf6dac1 100644
--- a/vllm/config/engram.py
+++ b/vllm/config/engram.py
@@ -35,7 +35,7 @@ class EngramConfig:
     """Configuration for Engram embedding storage and sharding."""
 
     disk_offload: bool = False
-    """Read verified local Engram rows on demand. Requires eager execution."""
+    """Read verified local Engram rows with eager or breakable execution."""
 
     cpu_offload: bool = True
     """Store embedding weights in pinned CPU memory for UVA lookup."""
diff --git a/vllm/config/vllm.py b/vllm/config/vllm.py
index 835b8fb..890f336 100644
--- a/vllm/config/vllm.py
+++ b/vllm/config/vllm.py
@@ -1412,12 +1412,23 @@ class VllmConfig:
                 or self.load_config.safetensors_load_strategy != "lazy"
                 or self.load_config.model_loader_extra_config.get("enable_multithread_load")
                 or model_config is None
-                or not model_config.enforce_eager
             ):
                 raise ValueError(
-                    "Disk Engram requires eager execution and single-threaded "
-                    "lazy safetensors loading"
+                    "Disk Engram requires single-threaded lazy safetensors loading"
                 )
+            if not model_config.enforce_eager:
+                compilation = self.compilation_config
+                if (
+                    compilation.mode != CompilationMode.NONE
+                    or compilation.cudagraph_mode != CUDAGraphMode.PIECEWISE
+                    or compilation.cudagraph_decoder_replay
+                    or not envs.VLLM_USE_BREAKABLE_CUDAGRAPH
+                    or not self.use_v2_model_runner
+                ):
+                    raise ValueError(
+                        "Disk Engram requires eager execution or V2 breakable "
+                        "PIECEWISE graphs without compilation or decoder replay"
+                    )
         self.engram_config.verify_model_config(model_config)
         self.engram_config.resolve_dp_shared_memory(self.parallel_config)
         self.engram_config.verify_parallel_config(self.parallel_config)
-- 
2.43.0


