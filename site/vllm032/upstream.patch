 vllm/config/vllm.py                                | 12 ++++++++++++
 vllm/model_executor/model_loader/default_loader.py |  1 +
 vllm/model_executor/model_loader/weight_utils.py   |  9 +++++++--
 4 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/vllm/config/engram.py b/vllm/config/engram.py
index 78a9834..ab19d01 100644
--- a/vllm/config/engram.py
+++ b/vllm/config/engram.py
@@ -97,9 +97,9 @@ class EngramConfig:
             )
 
     def verify_parallel_config(self, parallel_config: "ParallelConfig") -> None:
+        """Reject unsupported embedding parallel topologies."""
         if self.disk_offload and (parallel_config.tensor_parallel_size != 4 or parallel_config.data_parallel_size != 1):
             raise ValueError("Disk Engram requires TP4/DP1")
-        """Reject unsupported embedding parallel topologies."""
         if self.dp_shared_memory:
             if parallel_config.data_parallel_size <= 1:
                 raise ValueError("dp_shared_memory requires data_parallel_size > 1.")
diff --git a/vllm/config/vllm.py b/vllm/config/vllm.py
index f27c841..835b8fb 100644
--- a/vllm/config/vllm.py
+++ b/vllm/config/vllm.py
@@ -1406,6 +1406,18 @@ class VllmConfig:
             if not model_has_engram_layers(model_config):
                 return
             self.engram_config = EngramConfig()
+        if self.engram_config.disk_offload:
+            if (
+                self.load_config.load_format != "safetensors"
+                or self.load_config.safetensors_load_strategy != "lazy"
+                or self.load_config.model_loader_extra_config.get("enable_multithread_load")
+                or model_config is None
+                or not model_config.enforce_eager
+            ):
+                raise ValueError(
+                    "Disk Engram requires eager execution and single-threaded "
+                    "lazy safetensors loading"
+                )
         self.engram_config.verify_model_config(model_config)
         self.engram_config.resolve_dp_shared_memory(self.parallel_config)
         self.engram_config.verify_parallel_config(self.parallel_config)
