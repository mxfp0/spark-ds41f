+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+from vllm.model_executor.warmup.jit_warmup import VllmJitKernel
+
+
+def call(function, *args, **kwargs):
+    return function, args, kwargs
+
+
+class Call:
+    def __init__(self, function, args, kwargs):
+        self.function, self.args, self.kwargs = function, args, kwargs
+        self.key = (function, repr((args, sorted(kwargs.items()))))
+
+    def __hash__(self):
+        return hash(self.key)
+
+    def __eq__(self, other):
+        return isinstance(other, Call) and self.key == other.key
+
+
+class Kernels(VllmJitKernel[Call]):
+    def get_warmup_keys(self, calls):
+        return [Call(*item) for item in calls]
+
+    def compile(self, key):
+        key.function(*key.args, **key.kwargs)
+
+    def compile_many(self, keys):
+        import tilelang
+
+        tilelang.prepare([(k.function, k.args, k.kwargs) for k in keys], num_workers=2)
+
+
+KERNELS = Kernels()
