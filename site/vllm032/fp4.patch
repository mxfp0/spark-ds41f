+                Sinks: T.Tensor([heads], accum_dtype),
+                Positions: T.Tensor([rows], T.int64),
+                CosSin: T.Tensor([positions_max, ROPE_DIM], accum_dtype),
+                Output: T.Tensor([rows, heads, D], dtype),
+            ):
