+                O_shared[0, d] = T.fmul(o[d], L)
+            for d in T.Parallel(D):
+                Output[rc, hc, d] = O_shared[0, d]
+
+    # SWA-only layers (idx_width == 0) compile without the indexed tensors.
+    if schedule == "extend":
+        if idx_blocks:
