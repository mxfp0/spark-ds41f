+from functools import lru_cache
+
+import torch
+
+from vllm.compilation.breakable_cudagraph import eager_break_during_capture
+from vllm.forward_context import get_forward_context
+from vllm.models.deepseek_v4.nvidia.ops.o_proj import compute_fp8_einsum_recipe
+from vllm.models.deepseek_v41.attention import DeepseekV4Attention, DeepseekV4Indexer
+from vllm.models.deepseek_v41.compressor import DeepseekCompressor
+from vllm.models.deepseek_v41.nvidia.flashinfer_sparse import (
+    DeepseekSparseSWAFlashInferBackend,
+    DeepseekV4FlashInferMLASparseBackend,
+)
+from vllm.models.deepseek_v41.nvidia.ops.o_proj import dsv41_o_proj
+from vllm.v1.attention.backend import AttentionCGSupport, AttentionMetadataBuilder
+from vllm.v1.attention.backends.mla.compressor_utils import (
+    get_compressed_slot_mapping,
+    get_dspark_swa_index_width,
+)
+from vllm.v1.attention.backends.mla.indexer import (
+    DeepseekV32IndexerMetadata,
+    DeepseekV41IndexerBackend,
+)
+from vllm.v1.attention.backends.utils import split_decodes_and_prefills
+from vllm.v1.worker.workspace import current_workspace_manager
+
+from .cache_writer import write_cache, writer_call
+from .indexer import (
+    CANDIDATE_BLOCK,
+    CANDIDATE_BLOCKS,
+    IndexerV41Plan,
+    quantize_call,
+    quantize_mxfp4,
+    write_index_keys,
+)
+from .prepare import KERNELS
+from .rope import rope_, rope_call
+from .sparse_mla import SparseMlaV41Plan
+
+
+def pages(cache):
+    return cache.view(torch.uint8).flatten(1)
+
+
+class NativeBackend(DeepseekV4FlashInferMLASparseBackend):
+    supported_kv_cache_dtypes = ["auto", "fp8", "nvfp4_ds_mla"]
+
+    @staticmethod
+    def get_name():
+        return "TILELANG_DSV41"
+
+    @staticmethod
+    def get_supported_kernel_block_sizes(kv_cache_spec=None):
+        return [256]
+
+    @classmethod
+    def supports_compute_capability(cls, capability):
+        return capability.major == 12
+
+    @classmethod
+    def supports_combination(cls, **kwargs):
+        return (
+            None
+            if kwargs["kv_cache_dtype"] in (None, "auto", "fp8", "nvfp4_ds_mla")
+            else "Native attention requires NVFP4 compressed KV"
+        )
+
+
+class NativeIndexerMetadataBuilder(AttentionMetadataBuilder):
+    _cudagraph_support = AttentionCGSupport.ALWAYS
+
+    def __init__(self, kv_cache_spec, layer_names, vllm_config, device):
+        super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+        self._slots = torch.empty(
+            vllm_config.scheduler_config.max_num_batched_tokens,
+            dtype=torch.int64,
+            device=device,
+        )
+
+    def build(self, common_prefix_len, common_attn_metadata, fast_build=False):
+        common = common_attn_metadata
+        ratio = self.kv_cache_spec.tokens_per_state
+        slots = common.slot_mapping
+        if ratio > 1:
+            slots = get_compressed_slot_mapping(
+                common.num_actual_tokens,
+                slots,
+                common.query_start_loc,
+                common.seq_lens,
+                common.block_table_tensor,
+                self.kv_cache_spec.num_states,
+                ratio,
+                out=self._slots,
+            )
+        counts = split_decodes_and_prefills(common)
+        return DeepseekV32IndexerMetadata(
+            seq_lens=common.seq_lens,
+            max_seq_len=common.max_seq_len,
+            slot_mapping=slots,
+            num_decodes=counts[0],
+            num_prefills=counts[1],
+            num_decode_tokens=counts[2],
+            num_prefill_tokens=counts[3],
+            positions=common.positions,
+            block_table=common.block_table_tensor,
+        )
+
+
+class NativeIndexerBackend(DeepseekV41IndexerBackend):
+    @staticmethod
+    def get_supported_kernel_block_sizes(kv_cache_spec=None):
+        return [256]
+
+    @staticmethod
+    def get_builder_cls():
+        return NativeIndexerMetadataBuilder
+
+
+class NativeCompressor(DeepseekCompressor):
+    def insert_cache(self, latent, positions, rotary_emb):
+        metadata = get_forward_context().attn_metadata
+        if latent is None or not isinstance(metadata, dict):
+            return
+        source = self._static_forward_context[self.k_cache_prefix]
+        rotated = latent.clone()
+        rope_(rotated, positions, rotary_emb.cos_sin_cache, self.compress_ratio, False)
+        slots = metadata[self.k_cache_prefix].slot_mapping
+        write_cache(
+            rotated,
+            source.kv_cache,
+            slots,
+            page_size=source.kv_cache.shape[1],
+            cache_kind="indexed",
+        )
+
+
+class NativeIndexer(DeepseekV4Indexer):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.indexer_weights_dtype = torch.bfloat16
+
+    def _produce_k(self, latent, positions, rotary_emb):
+        metadata = get_forward_context().attn_metadata
+        if latent is None or not isinstance(metadata, dict):
+            return
+        key, _ = self.wk(latent)
+        key = self.k_norm(key).contiguous()
+        rope_(key, positions, rotary_emb.cos_sin_cache, self.compress_ratio, False)
+        slots = metadata[self.k_cache.prefix].slot_mapping
+        slots = torch.where((positions + 1) % self.compress_ratio == 0, slots, -1)
+        write_index_keys(
+            key, pages(self.k_cache.kv_cache), slots, self.k_cache.kv_cache.shape[1]
+        )
+
+    def forward_q(self, qr, qr_scale, indexer_weights, positions, rotary_emb):
+        query = self._wq_b_proj(qr, qr_scale).view(-1, self.n_head, self.head_dim)
+        rope_(query, positions, rotary_emb.cos_sin_cache, 1, False)
+        packed = torch.empty(
+            (*query.shape[:-1], self.head_dim // 2),
+            device=query.device,
+            dtype=torch.uint8,
+        )
+        scales = torch.empty(
+            (*query.shape[:-1], self.head_dim // 32),
+            device=query.device,
+            dtype=torch.uint8,
+        )
+        quantize_mxfp4(
+            query.reshape(-1, self.head_dim),
+            packed.reshape(-1, self.head_dim // 2),
+            scales.reshape(-1, self.head_dim // 32),
+        )
+        return packed, scales, (indexer_weights.float() * (1 / 64)).to(torch.bfloat16)
+
+
+@lru_cache(None)
+def mla_plan(heads, swa_width, indexed, page_size, maximum, device):
+    return SparseMlaV41Plan(
+        heads,
+        swa_width,
+        indexed,
+        page_size,
+        swa_page_size=32,
+        max_rows=maximum,
+        device=device,
+    )
+
+
+@lru_cache(None)
+def index_plan(width, page_size, reindex, source):
+    return IndexerV41Plan(width, page_size, candidates=reindex, candidate_blocks=source)
+
+
+class NativeAttention(DeepseekV4Attention):
+    backend_cls = NativeBackend
+    swa_backend_cls = DeepseekSparseSWAFlashInferBackend
+    compressor_cls = NativeCompressor
+
+    @property
+    def packed_kv_cache_dtype(self):
+        return "nvfp4_ds_mla"
+
+    @classmethod
+    def get_padded_num_q_heads(cls, num_heads):
+        return num_heads
+
+    def _indexer_cls(self, k_cache):
+        return NativeIndexer
+
+    def __init__(self, vllm_config, *args, **kwargs):
+        if vllm_config.parallel_config.tensor_parallel_size != 4:
+            raise ValueError("Native FP4 attention is qualified for TP4 only")
+        if vllm_config.attention_config.resolve_indexer_kv_dtype("fp8") != "mxfp4":
+            raise ValueError("Native FP4 attention requires indexer_kv_dtype=mxfp4")
+        super().__init__(vllm_config, *args, **kwargs)
+        self._einsum_recipe, self._tma_aligned_scales = compute_fp8_einsum_recipe(
+            self._o_proj_block_size
+        )
+        self._native_ready = False
+        self._native_device = str(self.rotary_emb.cos_sin_cache.device)
+        self._native_is_draft = (
+            self.layer_id >= vllm_config.model_config.hf_config.num_hidden_layers
+        )
+        self._native_swa_width = (
+            get_dspark_swa_index_width(
+                self.window_size, vllm_config.speculative_config.num_speculative_tokens
+            )
+            if self._native_is_draft and vllm_config.speculative_config
+            else self.window_size
+        )
+        self._native_candidates = kwargs.get("candidate_block_buffer")
+        self._native_counts = torch.empty(
+            self.max_num_batched_tokens, device=self._native_device, dtype=torch.int32
+        )
+        self._native_index_args = None
+        calls = SparseMlaV41Plan.calls(
+            self.n_local_heads,
+            self._native_swa_width,
+            512 if self.compress_ratio else 0,
+            256 // max(1, self.compress_ratio),
+            swa_page_size=32,
+            max_rows=self.max_num_batched_tokens,
+            device=self._native_device,
+        )
+        calls += [
+            rope_call(self.n_local_heads, 512, 64, 1, False),
+            rope_call(1, 512, 64, 1, False),
+            writer_call("swa", 32, torch.int64),
+        ]
+        if self.compressor is not None:
+            calls += [
+                rope_call(1, 512, 64, self.compress_ratio, False),
+                writer_call("indexed", 256 // self.compress_ratio, torch.int64),
+                rope_call(1, 128, 64, self.compress_ratio, False),
+                quantize_call(256 // self.compress_ratio),
+            ]
+        if self.indexer is not None:
+            reindex = (
+                self.candidate_source_layer >= 0
+                and self.layer_id > self.candidate_source_layer
+            )
+            width = (
+                CANDIDATE_BLOCKS * CANDIDATE_BLOCK
+                if reindex
+                else self.max_model_len // self.compress_ratio
+            )
+            self._native_index_args = (
+                width,
+                256 // self.compress_ratio,
+                reindex,
+                self.layer_id == self.candidate_source_layer,
+            )
+            calls += IndexerV41Plan.calls(
+                width,
+                256 // self.compress_ratio,
+                candidates=reindex,
+                candidate_blocks=self.layer_id == self.candidate_source_layer,
+            )
+            calls += [rope_call(32, 128, 64, 1, False), quantize_call()]
+        KERNELS.register_warmup(calls)
+
+    def _plans(self):
+        if not self._native_ready:
+            self._native_mla = mla_plan(
+                self.n_local_heads,
+                self._native_swa_width,
+                512 if self.compress_ratio else 0,
+                256 // max(1, self.compress_ratio),
+                self.max_num_batched_tokens,
+                self._native_device,
+            )
+            workspace = current_workspace_manager()
+            workspace.get_simultaneous(
+                *self._native_mla.scratch_specs(
+                    min(256, self._native_mla.decode_max_rows)
+                )
+            )
+            if self._native_index_args is not None:
+                self._native_index = index_plan(*self._native_index_args)
+                workspace.get_simultaneous(*self._native_index.scratch_specs(64))
+            self._native_ready = True
+
+    def _o_proj(self, attn_out, positions):
+        return dsv41_o_proj(self, attn_out, positions)
+
+    def _fused_qnorm_rope_kv_insert(self, q, kv, positions, attn_metadata):
+        if not isinstance(attn_metadata, dict):
+            return q
+        q = q.clone()
+        rope_(q, positions, self.rotary_emb.cos_sin_cache, 1, False)
+        metadata = attn_metadata[self.swa_cache_layer.prefix]
+        self.insert_swa_kv(kv, positions, metadata.slot_mapping)
+        return q
+
+    def insert_swa_kv(self, kv, positions, slot_mapping):
+        kv = kv.clone()
+        rope_(kv, positions, self.rotary_emb.cos_sin_cache, 1, False)
+        write_cache(
+            kv,
+            self.swa_cache_layer.kv_cache,
+            slot_mapping,
+            page_size=self.swa_cache_layer.block_size,
+            cache_kind="swa",
+        )
+
+    @eager_break_during_capture
+    def _sparse_indexer_and_attn(
+        self,
+        hidden_states,
+        index_q,
+        index_q_scale,
+        index_weights,
+        q,
+        kv,
+        positions,
+        out,
+    ):
+        metadata = get_forward_context().attn_metadata
+        if (
+            isinstance(metadata, dict)
+            and self.indexer is not None
+            and index_q is not None
+        ):
+            self._plans()
+            swa = metadata[self.swa_cache_layer.prefix]
+            index = metadata[self.indexer.k_cache.prefix]
+            tokens = swa.num_decode_tokens + swa.num_prefill_tokens
+            positions = positions[:tokens]
+            cache_lengths = ((positions + 1) // self.compress_ratio).to(torch.int32)
+            if self._native_is_draft:
+                decode = swa.num_decode_tokens
+                if decode:
+                    seq = swa.seq_lens.index_select(
+                        0, swa.token_to_req_indices[:decode]
+                    )
+                    cache_lengths[:decode] = (seq // self.compress_ratio).to(
+                        torch.int32
+                    )
+            cache_lengths.masked_fill_(~swa.is_valid_token[:tokens], 0)
+            active = torch.full(
+                (1,),
+                self.max_model_len // self.compress_ratio,
+                device=q.device,
+                dtype=torch.int32,
+            )
+            candidates = self._native_candidates
+            counts = (
+                (candidates[:tokens] >= 0).sum(-1, dtype=torch.int32)
+                if self._native_index_args[2]
+                else None
+            )
+            for start in range(0, tokens, 64):
+                stop = min(start + 64, tokens)
+                rows = stop - start
+                table = index.block_table.index_select(
+                    0, swa.token_to_req_indices[start:stop]
+                )
+                scratch = current_workspace_manager().get_simultaneous(
+                    *self._native_index.scratch_specs(rows)
+                )
+                self._native_index.run(
+                    index_q[start:stop],
+                    index_q_scale[start:stop],
+                    index_weights[start:stop],
+                    pages(self.indexer.k_cache.kv_cache),
+                    table,
+                    cache_lengths[start:stop],
+                    active,
+                    candidates[start:stop] if self._native_index_args[2] else None,
+                    counts[start:stop] if counts is not None else None,
+                    out=self.topk_indices_buffer[start:stop],
+                    candidate_out=candidates[start:stop]
+                    if self._native_index_args[3]
+                    else None,
+                    candidate_out_lengths=self._native_counts[start:stop]
+                    if self._native_index_args[3]
+                    else None,
+                    scratch=scratch,
+                )
+        self.forward_mqa(q, kv, positions, out)
+
+    def forward_mqa(self, q, kv, positions, output):
+        self._plans()
+        metadata = get_forward_context().attn_metadata
+        if not isinstance(metadata, dict):
+            output.zero_()
+            return
+        swa = metadata[self.swa_cache_layer.prefix]
+        tokens = swa.num_decode_tokens + swa.num_prefill_tokens
+        q, positions = q[:tokens], positions[:tokens]
+        indices = []
+        lengths = []
+        if swa.num_decode_tokens:
+            indices.append(swa.decode_swa_indices.squeeze(1))
+            lengths.append(swa.decode_swa_lens.reshape(-1))
+        if swa.num_prefill_tokens:
+            indices.append(swa.prefill_swa_indices.squeeze(1))
+            lengths.append(swa.prefill_swa_lens.reshape(-1))
+        indices = [
+            torch.nn.functional.pad(
+                value, (0, self._native_swa_width - value.shape[-1]), value=-1
+            )
+            for value in indices
+        ]
+        swa_indices = torch.cat(indices, 0)
+        swa_lengths = torch.cat(lengths, 0)
+        swa_lengths.masked_fill_(~swa.is_valid_token[:tokens], 0)
+        if swa_indices.shape[-1] < self._native_swa_width:
+            swa_indices = torch.nn.functional.pad(
+                swa_indices,
+                (0, self._native_swa_width - swa_indices.shape[-1]),
+                value=-1,
+            )
+        indexed = {}
+        if self.compress_ratio:
+            main = metadata[self.compressed_cache_prefix]
+            chosen = self.topk_indices_buffer[: q.shape[0]]
+            indexed = dict(
+                idx_cache=pages(self._compressed_kv_cache()),
+                idx_indices=chosen,
+                idx_lengths=(chosen >= 0).sum(-1, dtype=torch.int32),
+            )
+        for start in range(0, q.shape[0], 256):
+            stop = min(start + 256, q.shape[0])
+            part = {
+                key: value if key == "idx_cache" else value[start:stop]
+                for key, value in indexed.items()
+            }
+            if self.compress_ratio:
+                part["idx_page_table"] = main.block_table.index_select(
+                    0, swa.token_to_req_indices[start:stop]
+                )
+            specs = self._native_mla.scratch_specs(stop - start)
+            scratch = (
+                current_workspace_manager().get_simultaneous(*specs) if specs else None
+            )
+            self._native_mla.run(
+                q[start:stop],
+                pages(self.swa_cache_layer.kv_cache),
+                swa_indices[start:stop].contiguous(),
+                swa_lengths[start:stop].contiguous(),
+                self.attn_sink,
+                positions[start:stop],
+                self.rotary_emb.cos_sin_cache,
+                output[start:stop],
+                scratch=scratch,
+                **part,
+            )
