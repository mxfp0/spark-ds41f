+            @T.prim_func
+            def sparse_mla(
+                Q: T.Tensor([rows, heads, D], dtype),
+                SwaRecords: T.StridedTensor(
+                    [swa_pool, swa_bytes], [swa_stride, 1], T.uint8
+                ),
+                SwaIndices: T.Tensor([rows, swa_width], T.int32),
+                SwaLengths: T.Tensor([rows], T.int32),
